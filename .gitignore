# Python / uv
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# Never commit data: databases, source documents, logs
*.duckdb
*.duckdb.wal
*.xlsx
*.xls
*.pdf
logs/

# Editors / OS
.DS_Store
.vscode/
.idea/

# Local Claude Code settings and agent worktrees
.claude/settings.local.json
.claude/worktrees/

# Synthetic test documents stay local until Phase 3 moves them into tests/fixtures/
sample-financials/
# ...except the committed copy under tests/fixtures (synthetic, generated by code)
!tests/fixtures/sample-financials/
!tests/fixtures/sample-financials/**/*.pdf
