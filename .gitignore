# Python / uv
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# Never commit data: databases, source documents, logs
*.duckdb
*.duckdb.wal
*.xlsx
*.xls
*.pdf
logs/

# Editors / OS
.DS_Store
.vscode/
.idea/

# Local Claude Code settings and agent worktrees
.claude/settings.local.json
.claude/worktrees/

# The owner's local copy of the synthetic test documents (the tracked copy is in tests/fixtures/)
/sample-financials/

# Synthetic test documents are the only xlsx/pdf files that are committed
!tests/fixtures/sample-financials/**/*.xlsx
!tests/fixtures/sample-financials/**/*.pdf
