# System dependencies for fin-analyst. Installed by ./install.sh via `brew bundle`.
# Quarto is not here: its cask runs an installer that needs sudo. install.sh puts the pinned Quarto
# release in the home folder instead (~/.local/opt, linked from ~/.local/bin).
brew "uv"
brew "node"
brew "poppler"  # pdftoppm: Claude Code reads PDF pages as images for readings
